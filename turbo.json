{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "FUNCTIONS_BASE_URL",
    "WEB_AUTH_SECRET",
    "NODE_ENV",
    "AUTH_DEV_PASSWORD",
    "FUNCTIONS_AUTH_SECRET",
    "MSSQL_SERVER",
    "MSSQL_PORT",
    "MSSQL_USER",
    "MSSQL_SA_PASSWORD",
    "MSSQL_DATABASE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}